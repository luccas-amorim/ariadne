<body>

<main id="indice">
  <div class="miolo">
    <header>
      <h1>Filosofia do Direito</h1>
      <p class="autor">Hegel, 1820</p>
      <p class="dek-geral">Uma reconstrução em vinte e uma sessões, do prefácio à recepção, com um epílogo que faz o caminho de volta à Lógica. Toque numa sessão da régua ou da lista para ler o texto.</p>
    </header>

    <section aria-label="Régua das sessões, organizada pelas três partes da obra">
      <div class="regua"><div class="bar"><a class="seg g-por" data-n="0" href="#s-0" aria-label="Sessão 0: Prefácio e contexto">0</a><a class="seg g-por alt" data-n="1" href="#s-1" aria-label="Sessão 1: O conceito de direito e a ciência filosófica do direito">1</a><a class="seg g-por" data-n="2" href="#s-2" aria-label="Sessão 2: A vontade">2</a><a class="seg g-por alt" data-n="3" href="#s-3" aria-label="Sessão 3: O direito como existência da liberdade">3</a><a class="seg g-ser" data-n="4" href="#s-4" aria-label="Sessão 4: Pessoa e propriedade I">4</a><a class="seg g-ser alt" data-n="5" href="#s-5" aria-label="Sessão 5: Propriedade II">5</a><a class="seg g-ser" data-n="6" href="#s-6" aria-label="Sessão 6: Contrato">6</a><a class="seg g-ser alt" data-n="7" href="#s-7" aria-label="Sessão 7: O ilícito e o crime">7</a><a class="seg g-ser" data-n="8" href="#s-8" aria-label="Sessão 8: A pena">8</a><a class="seg g-ess" data-n="9" href="#s-9" aria-label="Sessão 9: Propósito, responsabilidade, intenção e bem-estar">9</a><a class="seg g-ess alt" data-n="10" href="#s-10" aria-label="Sessão 10: O bem e a consciência moral">10</a><a class="seg g-con" data-n="11" href="#s-11" aria-label="Sessão 11: O conceito de eticidade">11</a><a class="seg g-con alt" data-n="12" href="#s-12" aria-label="Sessão 12: A família">12</a><a class="seg g-con" data-n="13" href="#s-13" aria-label="Sessão 13: Sociedade civil I: princípios e sistema das necessidades">13</a><a class="seg g-con alt" data-n="14" href="#s-14" aria-label="Sessão 14: Sociedade civil II: administração da justiça">14</a><a class="seg g-con" data-n="15" href="#s-15" aria-label="Sessão 15: Sociedade civil III: polícia e corporação">15</a><a class="seg g-con alt" data-n="16" href="#s-16" aria-label="Sessão 16: O conceito de Estado">16</a><a class="seg g-con" data-n="17" href="#s-17" aria-label="Sessão 17: Constituição interna I: poderes, soberania e burocracia">17</a><a class="seg g-con alt" data-n="18" href="#s-18" aria-label="Sessão 18: Constituição interna II: legislativo, opinião pública, soberania externa e guerra">18</a><a class="seg g-con" data-n="19" href="#s-19" aria-label="Sessão 19: Direito internacional e história mundial">19</a><a class="seg g-fec" data-n="20" href="#s-20" aria-label="Sessão 20: A recepção">20</a></div><div class="ticks" aria-hidden="true"><span class="tick" style="left:9.524%">Introdução</span><span class="tick" style="left:30.952%">Direito abstrato</span><span class="tick" style="left:47.619%">Moralidade</span><span class="tick" style="left:73.810%">Eticidade</span></div></div>
      <ul class="legenda"><li><span class="sw g-por"></span>Prefácio, Introdução e fecho</li><li><span class="sw g-ser"></span>Parte I: Direito abstrato</li><li><span class="sw g-ess"></span>Parte II: Moralidade</li><li><span class="sw g-con"></span>Parte III: Eticidade</li></ul>
    </section>

    <ol class="linha"><li class="item g-por"><a href="#s-0"><span class="anos">Pórtico</span><span class="cab"><span class="rot">Sessão 0</span><span class="tit">Prefácio e contexto</span><span class="dek">A coruja de Minerva, o racional efetivo, <em>Hic Rhodus</em>, Fries, Karlsbad e o estatuto dos adendos.</span></span></a></li><li class="item g-por"><a href="#s-1"><span class="anos">Introdução</span><span class="cab"><span class="rot">Sessão 1</span><span class="tit">O conceito de direito e a ciência filosófica do direito</span><span class="dek">A ideia do direito, a crítica das definições e a fronteira com o direito positivo (§§ 1–3).</span></span></a></li><li class="item g-por"><a href="#s-2"><span class="anos">Introdução</span><span class="cab"><span class="rot">Sessão 2</span><span class="tit">A vontade</span><span class="dek">Universalidade, particularização e singularidade; o arbítrio e a vontade livre que quer a vontade livre (§§ 4–28).</span></span></a></li><li class="item g-por"><a href="#s-3"><span class="anos">Introdução</span><span class="cab"><span class="rot">Sessão 3</span><span class="tit">O direito como existência da liberdade</span><span class="dek">A definição contra Kant, a colisão dos direitos, ordem lógica e temporal e a divisão da obra (§§ 29–33).</span></span></a></li><li class="item g-ser"><a href="#s-4"><span class="anos">Parte I</span><span class="cab"><span class="rot">Sessão 4</span><span class="tit">Pessoa e propriedade I</span><span class="dek">A pessoa, o mandamento jurídico, a coisa, o corpo e a desigualdade (§§ 34–53).</span></span></a></li><li class="item g-ser"><a href="#s-5"><span class="anos">Parte I</span><span class="cab"><span class="rot">Sessão 5</span><span class="tit">Propriedade II</span><span class="dek">Tomada de posse, escravidão, uso, domínio dividido, bens inalienáveis e a vida (§§ 54–71).</span></span></a></li><li class="item g-ser"><a href="#s-6"><span class="anos">Parte I</span><span class="cab"><span class="rot">Sessão 6</span><span class="tit">Contrato</span><span class="dek">A vontade comum, o casamento e o Estado que não são contratos, a estipulação e a lesão (§§ 72–81).</span></span></a></li><li class="item g-ser"><a href="#s-7"><span class="anos">Parte I</span><span class="cab"><span class="rot">Sessão 7</span><span class="tit">O ilícito e o crime</span><span class="dek">Litígio, fraude e crime; a coação que se destrói e o direito dos heróis (§§ 82–96).</span></span></a></li><li class="item g-ser"><a href="#s-8"><span class="anos">Parte I</span><span class="cab"><span class="rot">Sessão 8</span><span class="tit">A pena</span><span class="dek">A nulidade do crime, o direito do criminoso, a igualdade de valor e a vingança (§§ 97–104).</span></span></a></li><li class="item g-ess"><a href="#s-9"><span class="anos">Parte II</span><span class="cab"><span class="rot">Sessão 9</span><span class="tit">Propósito, responsabilidade, intenção e bem-estar</span><span class="dek">O direito do saber, as consequências, o incêndio, a boa intenção e o direito de necessidade (§§ 105–128).</span></span></a></li><li class="item g-ess"><a href="#s-10"><span class="anos">Parte II</span><span class="cab"><span class="rot">Sessão 10</span><span class="tit">O bem e a consciência moral</span><span class="dek">O formalismo kantiano, a consciência como santuário, o mal, a convicção e a ironia (§§ 129–141).</span></span></a></li><li class="item g-con"><a href="#s-11"><span class="anos">Parte III</span><span class="cab"><span class="rot">Sessão 11</span><span class="tit">O conceito de eticidade</span><span class="dek">Substância e indivíduos, o dever que liberta, a retidão e a segunda natureza (§§ 142–157).</span></span></a></li><li class="item g-con"><a href="#s-12"><span class="anos">Parte III</span><span class="cab"><span class="rot">Sessão 12</span><span class="tit">A família</span><span class="dek">Amor, casamento, os sexos, patrimônio, filhos, divórcio e herança (§§ 158–181).</span></span></a></li><li class="item g-con"><a href="#s-13"><span class="anos">Parte III</span><span class="cab"><span class="rot">Sessão 13</span><span class="tit">Sociedade civil I: princípios e sistema das necessidades</span><span class="dek">O Estado exterior, a formação, a economia política, a divisão do trabalho e os estamentos (§§ 182–208).</span></span></a></li><li class="item g-con"><a href="#s-14"><span class="anos">Parte III</span><span class="cab"><span class="rot">Sessão 14</span><span class="tit">Sociedade civil II: administração da justiça</span><span class="dek">A lei e a codificação, os trinta e nove golpes, a periculosidade, o tribunal e o júri (§§ 209–229).</span></span></a></li><li class="item g-con"><a href="#s-15"><span class="anos">Parte III</span><span class="cab"><span class="rot">Sessão 15</span><span class="tit">Sociedade civil III: polícia e corporação</span><span class="dek">O poder de polícia, a pobreza e a plebe, as colônias e a corporação (§§ 230–256).</span></span></a></li><li class="item g-con"><a href="#s-16"><span class="anos">Parte III</span><span class="cab"><span class="rot">Sessão 16</span><span class="tit">O conceito de Estado</span><span class="dek">Contra Rousseau e Haller, a liberdade concreta, o patriotismo e a religião (§§ 257–271).</span></span></a></li><li class="item g-con"><a href="#s-17"><span class="anos">Parte III</span><span class="cab"><span class="rot">Sessão 17</span><span class="tit">Constituição interna I: poderes, soberania e burocracia</span><span class="dek">A crítica ao equilíbrio dos poderes, o monarca, a graça, o governo e o caso Arnold (§§ 272–297).</span></span></a></li><li class="item g-con"><a href="#s-18"><span class="anos">Parte III</span><span class="cab"><span class="rot">Sessão 18</span><span class="tit">Constituição interna II: legislativo, opinião pública, soberania externa e guerra</span><span class="dek">Os estamentos, o sufrágio, a opinião pública, a imprensa e o momento ético da guerra (§§ 298–329).</span></span></a></li><li class="item g-con"><a href="#s-19"><span class="anos">Parte III</span><span class="cab"><span class="rot">Sessão 19</span><span class="tit">Direito internacional e história mundial</span><span class="dek">Nenhum pretor entre os Estados, o tribunal do mundo, os bárbaros e os quatro reinos (§§ 330–360).</span></span></a></li><li class="item g-fec"><a href="#s-20"><span class="anos">Fecho</span><span class="cab"><span class="rot">Sessão 20</span><span class="tit">A recepção</span><span class="dek">As escolas, Marx, as leituras do século XX, Honneth, Larenz, Jakobs, Pachukanis e o balanço de Ilting.</span></span></a></li><li class="item g-pro"><a href="#s-e"><span class="anos">Epílogo</span><span class="cab"><span class="rot">Depois da Sessão 20</span><span class="tit">Visão de conjunto e o caminho de volta à Lógica</span><span class="dek">A arquitetura da obra, as três linhas de força e o mapa de correspondências com a Lógica.</span></span></a></li></ol>

    <footer class="pe">Textos reunidos de uma conversa com Claude, em outubro de 2026. As sessões trazem o texto integral das respostas originais; os adendos (<em>Zusätze</em>) de Gans vêm sempre sinalizados como tais.</footer>
  </div>
</main>

